<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The voice call: on-device speech recognition needs the mic.
         Only the recognized words travel — audio never leaves the app. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- AdMob: the advertising ID (Android 13 permission model) -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <!-- Self-updates: the app rebuilds itself from delta patches and hands
         the result straight to the system PackageInstaller — no store, no
         browser round-trip, one-time "allow from this source" flip. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="Orubus AI"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Orubus"
        android:allowBackup="true"
        android:supportsRtl="true">

        <!-- AdMob application id — the real Orubus AdMob app. The UNIT ids stay
             server-side: the app fetches them from our backend at load time
             (signed-build attestation), so nothing ad-shaped lives in the APK. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-6399329891118246~2593948632" />

        <!-- Analytics + AdMob both ship an AD_SERVICES_CONFIG property; the
             merger can't pick — Analytics wins, per Google's documented fix. -->
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/ga_ad_services_config"
            tools:replace="android:resource" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The self-update session's outcome lands here (the process is
             usually killed mid-install — prefs carry the news to next launch). -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />

        <!-- AdActivity is declared by the play-services-ads SDK manifest itself —
             declaring it here caused a manifest-merger conflict (theme). -->
    </application>
</manifest>
