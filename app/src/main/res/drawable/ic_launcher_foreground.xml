<?xml version="1.0" encoding="utf-8"?>
<!-- The Orubus mark: an open soul-ring (the gap is where you walk in)
     with a quiet eye at the center and an orbit dot resting in the gap.
     Deliberately minimal — one ring, two dots. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- open ring: 270° arc, gap at the top-right (45°) -->
    <path
        android:pathData="M70.97,37.03 A24,24 0 1,0 70.97,70.97"
        android:strokeColor="#141414"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- the eye -->
    <path
        android:pathData="M54,47.5 a6.5,6.5 0 1,0 0.01,0 z"
        android:fillColor="#141414" />

    <!-- orbit dot sitting in the gap -->
    <path
        android:pathData="M78.5,54 m-4.5,0 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0"
        android:fillColor="#141414" />
</vector>
